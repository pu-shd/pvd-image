# ---------------------------------------------------------------------------
# Copy this file to config.env and fill in your own values.
#
#   cp config.env.example config.env
#
# config.env is git-ignored: it holds your subscription and host identifiers,
# which are yours and should not be committed. Nothing here is a secret in the
# credential sense — authentication is your own `az login` — but subscription
# IDs and host names are identifiers you probably do not want in a public repo.
# ---------------------------------------------------------------------------

# --- Target image VM ------------------------------------------------------
#
# The Azure subscription, resource group and VM name of the image VM you are
# building. Find them with:
#
#   az account list --query "[].{name:name, id:id}" -o table
#   az vm list -o table
#
# If you only know the VM's private IP, this finds the rest (needs the
# resource-graph extension: az extension add --name resource-graph):
#
#   az graph query -q "resources
#     | where type =~ 'microsoft.network/networkinterfaces'
#     | mv-expand ipconfig=properties.ipConfigurations
#     | where ipconfig.properties.privateIPAddress == '<YOUR.VM.IP.HERE>'
#     | project name, resourceGroup, subscriptionId,
#               vm=tostring(properties.virtualMachine.id)"
#
AVD_SUBSCRIPTION_ID="REPLACE_WITH_SUBSCRIPTION_ID"
AVD_RESOURCE_GROUP="REPLACE_WITH_RESOURCE_GROUP"
AVD_VM_NAME="REPLACE_WITH_VM_NAME"

# --- Visual Studio --------------------------------------------------------
#
# IMPORTANT: Visual Studio Community has NO fixed-version bootstrapper.
# Microsoft ships those for Enterprise/Professional/Build Tools only, and
# documents that Community "is only supported on the Stable channel using the
# latest version". So the tooling installs latest-Stable and then ASSERTS the
# result matches what you put here. When a newer Stable ships, the run fails
# loudly instead of quietly producing a different image, and you bump these
# values deliberately. See docs/visual-studio.md.
#
# Look up the current release and build at:
#   https://learn.microsoft.com/en-us/visualstudio/releases/2026/release-history
#
# VS_EXPECTED_VERSION is catalog.productDisplayVersion (e.g. 18.10.0).
#
# Deliberately left unset: this repository does not ship a version opinion,
# because any value committed here goes stale the next time Stable moves and
# would give you a confusing drift failure on your first run. Look up the
# current release at the link above and put it here.
VS_EXPECTED_VERSION="REPLACE_WITH_VS_VERSION"

# Optional exact build pin, tighter than the version above. vswhere reports
# catalog.buildVersion as e.g. 18.10.12201.205; the release-history table
# publishes the tail, 12201.205. Either form is accepted.
#
# Empty accepts any build of VS_EXPECTED_VERSION, which is usually what you
# want. Set it when you need an image to be byte-for-byte reproducible against
# a specific build.
VS_EXPECTED_BUILD=""

# Bootstrapper URL. The major version in the path must match the version above
# (18 -> Visual Studio 2026). Note the channel is 'Stable', not 'release'.
VS_BOOTSTRAPPER_URL="https://aka.ms/vs/18/Stable/vs_community.exe"

# Where Visual Studio should be installed. Leave empty to accept the
# installer's default. If set, the tooling verifies the install actually landed
# here — an unquoted path with spaces otherwise installs to C:\Program.
VS_INSTALL_PATH="C:\Program Files\Microsoft Visual Studio\2026\Community"

# --- All-users desktop shortcuts -----------------------------------------
#
# 'Name=Target' pairs separated by ';'. Shortcuts are placed in
# C:\Users\Public\Desktop so every user of a multi-session host sees them.
#
# 'Name' is also used to look for the application's own Start Menu shortcut
# ("<Name>.lnk"); if found it is copied, which preserves the vendor icon.
#
# The Excel path below is the standard Microsoft 365 Apps (Click-to-Run) x64
# location. Confirm yours with:
#   Get-ChildItem 'C:\Program Files\Microsoft Office' -Recurse -Filter EXCEL.EXE
#
# Add more by extending the list, e.g.
#   AVD_SHORTCUTS="Excel=...\EXCEL.EXE;Word=...\WINWORD.EXE"
AVD_SHORTCUTS="Excel=C:\Program Files\Microsoft Office\root\Office16\EXCEL.EXE"

# --- PyKX query client (pykx.sh) ----------------------------------------
#
# Only needed if you run ./pykx.sh. Installs Python and PyKX for all users,
# under PYKX_INSTALL_PATH, and sets PYKX_UNLICENSED=true machine-wide, so users
# can query a kdb+/q server with no licence and no admin rights. See
# docs/pykx.md.
#
# Left as placeholders for the same reason as the Visual Studio version: pin
# what you have tested. Releases:
#   PyKX: https://pypi.org/project/pykx/#history
#   uv:   https://github.com/astral-sh/uv/releases  (the SHA-256 is the
#         contents of uv-x86_64-pc-windows-msvc.zip.sha256 on that release)
PYKX_VERSION="REPLACE_WITH_PYKX_VERSION"
PYKX_PYTHON_VERSION="REPLACE_WITH_PYTHON_VERSION"
PYKX_UV_VERSION="REPLACE_WITH_UV_VERSION"
PYKX_UV_SHA256="REPLACE_WITH_UV_SHA256"

# Optional. Extra pip requirements, ';'-separated, e.g. "jupyterlab==4.4.5".
PYKX_EXTRA_PACKAGES=""

# Where to install, and the names of the commands users run:
# <prefix>-python, and <prefix>-test when a check host is set.
PYKX_INSTALL_PATH="C:\Program Files\PyKX"
PYKX_COMMAND_PREFIX="pykx"

# Optional. A q server to query from the VM after installing. When set, a
# failed query fails the run: an image whose users cannot reach their server
# is not finished. Leave empty to skip.
PYKX_CHECK_HOST=""
PYKX_CHECK_PORT=""

# --- Run-command behaviour -----------------------------------------------
#
# A full Visual Studio install takes 30-45 minutes on 8 vCPUs. The Azure
# managed run-command ceiling is 90 minutes (5400s).
AVD_RUNCMD_TIMEOUT_SECONDS="5400"
AVD_RUNCMD_NAME="install-vs-cpp"
AVD_POLL_INTERVAL_SECONDS="30"
